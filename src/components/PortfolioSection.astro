---

<section id="portfolio" class="portfolio">
    <div class="section-container">
        <span class="section-tag">LIFE AT IBASHO HOMES</span>
        <h2 class="section-title">A community of celebration, cultivation, and cooperation.</h2>
        <BaseSwiper sliderName="portfolio">
            {
                projects.map((project) => (
                    <div class="swiper-slide">
                        <div class="project-media">
                            <video
                                class="slide-video"
                                autoplay
                                loop
                                muted
                                playsinline
                                poster={project.video?.poster || project.images?.after?.src}
                            >
                                <source
                                    src={project.video?.src || project.images?.after?.src}
                                    type="video/mp4"
                                />
                            </video>
                        </div>
                        <div class="project-info">
                            <div class="info-section">
                                <h3 class="section-subtitle info-title">
                                    {project.info.challenge.title}
                                </h3>
                                <p class="info-text">
                                    {project.info.challenge.text}
                                </p>
                            </div>
                           
                        </div>
                    </div>
                ))
            }
        </BaseSwiper>
    </div>
</section>

<style>
    :global(.portfolio-swiper) {
        padding-inline: var(--px-64);
        position: relative;
    }

    .swiper-slide {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--px-64);
        opacity: 0;
        transform: scale(0.75);
        transition: all var(--transition-long);
    }

    .swiper-slide-active {
        opacity: 1;
        transform: scale(1);
    }

    .swiper-slide-prev,
    .swiper-slide-next {
        opacity: 0;
        transform: scale(0.75);
    }

    .project-media {
        position: relative;
        min-height: 25rem;
        height: 100%;
        overflow: hidden;
        border-radius: var(--radius-sm, 0.5rem);
        background-color: #000;
    }

    .slide-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .project-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: var(--px-32);
    }

    .info-section {
        display: flex;
        flex-direction: column;
        gap: var(--px-16);
    }

    .info-title {
        margin-bottom: 0;
    }

    @media screen and (max-width: 64rem) {
        .swiper-slide {
            gap: var(--px-32);
        }
    }

    @media screen and (max-width: 55rem) {
        :global(.portfolio-swiper) {
            padding-inline: 0;
        }

        .swiper-slide {
            grid-template-columns: 1fr;
            gap: var(--px-32);
        }

        .project-media {
            min-height: 18rem;
        }
    }
</style>

<script>
    import { initSwiper } from "@utils/initSwiper";

    function initPortfolioSlider() {
        const portfolioSwiper = initSwiper("portfolio", {
            spaceBetween: 30,
            navigation: {
                nextEl: ".portfolio-next",
                prevEl: ".portfolio-prev",
            },
            pagination: {
                el: ".portfolio-pagination",
                clickable: true,
            },
        });

        // Helper to control playback on slide change
        const manageVideoPlayback = () => {
            portfolioSwiper.slides.forEach((slide: HTMLElement, idx: number) => {
                const vid = slide.querySelector<HTMLVideoElement>("video");
                if (!vid) return;

                if (idx === portfolioSwiper.activeIndex) {
                    vid.play().catch(() => {});
                } else {
                    vid.pause();
                    vid.currentTime = 0;
                }
            });
        };

        // Listen for slide movements
        portfolioSwiper.on("slideChange", manageVideoPlayback);

        // Ensure active slide video starts playing on load
        manageVideoPlayback();

        return () => {
            portfolioSwiper.destroy();
        };
    }

    let cleanup = initPortfolioSlider();

    document.addEventListener("astro:after-swap", () => {
        if (cleanup) cleanup();
        cleanup = initPortfolioSlider();
    });
</script>