---
import { SITE } from '@consts';
---

<section id="contact" class="contact">
  <div class="section-container contact-container">
    <div class="contact-top">
      <div class="contact-top-left">
        <span class="section-tag">PARTNER WITH US</span>
        <h2 class="section-title">
          Investors, Joint Developers, Land Owners — we're looking for you.
        </h2>
      </div>

      <address class="contact-top-right contact-info">
        <div>
          <div class="contact-icon">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill-rule="evenodd"
              clip-rule="evenodd"
            >
              <path
                d="M24 21h-24v-18h24v18zm-23-16.477v15.477h22v-15.477l-10.999 10-11.001-10zm21.089-.523h-20.176l10.088 9.171 10.088-9.171z"
              ></path>
            </svg>
            <div class="contact-icon-s">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm3.445 17.827c-3.684 1.684-9.401-9.43-5.8-11.308l1.053-.519 1.746 3.409-1.042.513c-1.095.587 1.185 5.04 2.305 4.497l1.032-.505 1.76 3.397-1.054.516z"
                ></path>
              </svg>
            </div>
          </div>
          <h3 class="contact-subtitle">Say hello</h3>
          <div class="contact-details">
            <a href=`mailto:${SITE.EMAIL}` class="contact-detail contact-email"
              >{SITE.EMAIL}</a
            >
          </div>
        </div>
        <div>
          <div class="contact-icon">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill-rule="evenodd"
              clip-rule="evenodd"
            >
              <path
                d="M12 10c-1.104 0-2-.896-2-2s.896-2 2-2 2 .896 2 2-.896 2-2 2m0-5c-1.657 0-3 1.343-3 3s1.343 3 3 3 3-1.343 3-3-1.343-3-3-3m-7 2.602c0-3.517 3.271-6.602 7-6.602s7 3.085 7 6.602c0 3.455-2.563 7.543-7 14.527-4.489-7.073-7-11.072-7-14.527m7-7.602c-4.198 0-8 3.403-8 7.602 0 4.198 3.469 9.21 8 16.398 4.531-7.188 8-12.2 8-16.398 0-4.199-3.801-7.602-8-7.602"
              ></path>
            </svg>
          </div>
          <h3 class="contact-subtitle">Drop In</h3>
          <a
            class="contact-detail contact-address"
            href=`https://maps.google.com/?q=${SITE.ADDRESS}`
            >{SITE.ADDRESS}</a
          >
        </div>
      </address>
    </div>

    <div class="contact-bottom">
      <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="27ff50dd-2c1d-4c17-ac6f-bc8a29672528" />
        <input type="hidden" name="subject" value="New Inquiry from Ibasho Homes" />
        <input type="hidden" name="from_name" value="Ibasho Homes Website" />
        <input type="hidden" name="redirect" value="https://www.ibasho.homes/#contact" />
        <input type="checkbox" name="botcheck" class="botcheck-field" />

        <div class="contact-form-fields">
          <div class="form-group">
            <label class="form-label" for="name">Name</label>
            <input
              class="form-input"
              id="name"
              name="name"
              type="text"
              placeholder="Enter your name"
              required
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input
              class="form-input"
              id="email"
              name="email"
              type="email"
              placeholder="Enter your email"
              required
            />
          </div>
          <div class="form-group message-group">
            <label class="form-label" for="message">Message</label>
            <textarea
              class="form-input form-textarea"
              id="message"
              name="message"
              placeholder="Enter your message"
              rows="4"
              required></textarea>
          </div>
        </div>
        <div class="form-submit">
          <button type="submit" class="btn btn--primary">SEND MESSAGE</button>
          <div class="contact-terms">
            <span class="contact-terms-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                ><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"
                ></path><path d="M12 8h.01"></path></svg
              >
            </span>
            All the fields are required. By sending the form you agree to the
            <a class="text-link" href="legal/terms">Terms & Conditions</a> and
            <a class="text-link" href="legal/privacy">Privacy Policy</a>.
          </div>
        </div>
      </form>

      <div class="contact-map">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d117711.91484915413!2d86.1757708!3d22.784028399999997!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39f5e31989f0e2b5%3A0xeeec8e81ce9b344!2sJamshedpur%2C%20Jharkhand!5e0!3m2!1sen!2sin!4v1792400481141!5m2!1sen!2sin"
          title="Map showing Jamshedpur, Jharkhand, India"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
  }

  .botcheck-field {
    display: none !important;
    position: absolute;
    opacity: 0;
    pointer-events: none;
    height: 0;
    width: 0;
  }

  .section-container.contact-container {
    display: grid;
    grid-template-rows: auto auto;
  }

  .contact-top,
  .contact-bottom {
    gap: var(--px-32);
  }

  .contact-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .contact-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;